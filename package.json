{
  "name": "homeface",
  "author": "jackson",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Homeface",
    "uuid": "5b1c7a52-3f0e-4d9b-8a47-6c2e9d0f1a83",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "location",
      "health",
      "configurable"
    ],
    "messageKeys": [
      "TEMP",
      "ICON",
      "TZ_OFFSET",
      "TZ_LABEL",
      "COMPLICATION",
      "THEME",
      "ACCENT",
      "UNIT",
      "ZONE"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_TIME_72",
          "file": "fonts/SpaceGrotesk-SemiBold.ttf",
          "characterRegex": "[0-9]"
        },
        {
          "type": "font",
          "name": "FONT_NUM_22",
          "file": "fonts/SpaceGrotesk-SemiBold.ttf",
          "characterRegex": "[-0-9:%,.K°CF]"
        },
        {
          "type": "font",
          "name": "FONT_SMALL_14",
          "file": "fonts/Pix-mono10.ttf"
        },
        {
          "type": "font",
          "name": "FONT_DATE_18",
          "file": "fonts/Pix-mono12.ttf"
        },
        {
          "type": "font",
          "name": "FONT_ICONS_25",
          "file": "fonts/Pix-icons.ttf"
        },
        {
          "type": "font",
          "name": "FONT_SMALL_BOLD_14",
          "file": "fonts/Pix-mono10-bold.ttf"
        },
        {
          "type": "font",
          "name": "FONT_DATE_BOLD_18",
          "file": "fonts/Pix-mono12-bold.ttf"
        }
      ]
    }
  }
}